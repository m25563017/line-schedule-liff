# Cloud Functions 環境變數範本
# 使用方式：複製為 functions/.env 並填入你自己的值。.env 已被 .gitignore 排除，請勿提交真實金鑰。

# LINE Messaging API 頻道（LINE Developers Console > Messaging API）
CHANNEL_ACCESS_TOKEN=your_channel_access_token
CHANNEL_SECRET=your_channel_secret

# 選填：LIFF ID（LINE Developers Console > LIFF）。未設定時使用 functions/index.js 內的預設值
# LIFF_ID=your_liff_id
